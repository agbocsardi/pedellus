{
  "workspace": "./workspace",
  "dataDir": "./data",
  "modelPresets": {
    "fast": { "provider": "openai", "modelId": "gpt-6-luna", "thinkingLevel": "off" },
    "deep": { "provider": "openai", "modelId": "gpt-6-sol", "thinkingLevel": "high" }
  },
  "modelPreset": "deep",
  "workspaceContext": {
    "memoryFiles": ["memory/MEMORY.md"],
    "memoryManifest": true,
    "skills": {}
  },
  "toolAllowlist": ["read", "write", "edit"],
  "followUpMode": "followUp",
  "cron": {
    "enabled": true,
    "timeZone": "UTC"
  },
  "episodeSummary": {
    "enabled": true
  },
  "workers": {
    "enabled": false,
    "toolAllowlist": ["read", "write", "edit", "bash", "skill", "history", "web_search", "web_fetch", "codemode", "tool_search", "mcp"]
  },
  "digest": {
    "preset": "fast",
    "entriesPerBatch": 2000,
    "charsPerBatch": 200000,
    "maxToolCalls": 24,
    "maxRequests": 12,
    "maxInputTokens": 500000,
    "runTimeoutSeconds": 600,
    "maxChangedFiles": 8,
    "maxDiffChars": 32000
  },
  "credentials": {
    "anthropic": "ANTHROPIC_API_KEY",
    "deepseek": "DEEPSEEK_API_KEY",
    "minimax_anthropic": "MINIMAX_API_KEY",
    "moonshot": "MOONSHOT_API_KEY",
    "openai": "OPENAI_API_KEY",
    "openrouter": "OPENROUTER_API_KEY",
    "opencode_zen": "OPENCODE_API_KEY",
    "opencode_go": "OPENCODE_API_KEY",
    "xiaomi_mimo": "XIAOMIMIMO_API_KEY"
  }
}
