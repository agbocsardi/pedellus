[Unit]
Description=Pedellus gateway (secondary instance %i)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
# Replace /usr/bin/node with the absolute Node >= 22.19 executable and
# /opt/pedellus with this checkout's absolute path. The source launcher
# loads TypeScript with the pinned tsx runtime; restart picks up edits without a build.
#
# The instance name is a systemd unit instance identifier, not a filesystem
# path. It selects one fixed configuration directory under the owner's home.
# The literal `i-` prefix keeps even a dot-like instance name inside a real
# directory instead of allowing it to name `..`; systemd also refuses names that
# are not valid normalized unit instance names, including any name with `/`.
ExecStart=/usr/bin/node /opt/pedellus/bin/pedellus.mjs gateway --config %h/.pedellus/instances/i-%i/config.json
WorkingDirectory=%h/.pedellus/instances/i-%i
# Explicit, predictable PATH for shell tools, skills, MCP stdio lookup and local
# transcription (uv). Extend it with a drop-in, never a login-shell profile.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Account this service cgroup's memory only; no guessed hard limit is imposed.
# Add an optional MemoryHigh=/MemoryMax= drop-in when the host needs a bound.
MemoryAccounting=yes
# Optional per-instance environment, e.g. one provider key per line. Keep the
# file private and outside this repository; it is ignored when absent.
EnvironmentFile=-%h/.pedellus/instances/i-%i/secrets.env
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
