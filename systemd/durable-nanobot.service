[Unit]
Description=Durable Nanobot gateway (primary configuration)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
# Replace /usr/bin/node with the absolute Node >= 22.19 executable and
# /opt/durable-nanobot with this checkout's absolute path. The source launcher
# loads TypeScript with the pinned tsx runtime; restart picks up edits without a build.
# Never point this unit at Python's `nanobot` command.
ExecStart=/usr/bin/node /opt/durable-nanobot/bin/durable-nanobot.mjs gateway --config %h/.durable-nanobot/config.json
WorkingDirectory=%h/.durable-nanobot
# Optional per-instance environment, e.g. one provider key per line. Keep the
# file private and outside this repository; it is ignored when absent.
EnvironmentFile=-%h/.durable-nanobot/secrets.env
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
