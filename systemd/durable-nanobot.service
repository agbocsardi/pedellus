[Unit]
Description=Durable Nanobot gateway (primary configuration)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
# Replace /usr/bin/node with the absolute Node >= 22.19 executable and
# /opt/durable-nanobot with this checkout's absolute path. Run dist/cli.js
# through Node directly, independently of the optional linked CLI command.
# Never point this unit at Python's `nanobot` command.
ExecStart=/usr/bin/node /opt/durable-nanobot/dist/cli.js gateway --config %h/.durable-nanobot/config.json
WorkingDirectory=%h/.durable-nanobot
# Optional per-instance environment, e.g. one provider key per line. Keep the
# file private and outside this repository; it is ignored when absent.
EnvironmentFile=-%h/.durable-nanobot/env
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
