[Unit]
Description=Durable Nanobot gateway (secondary instance %i)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
# Replace /usr/bin/node with the absolute Node >= 22.19 executable and
# /opt/durable-nanobot with this checkout's absolute path. Run dist/cli.js
# through Node directly, independently of the optional linked CLI command.
# Never point this unit at Python's `nanobot` command.
#
# The instance name is a systemd unit instance identifier, not a filesystem
# path. It selects one fixed configuration directory under the owner's home.
# The literal `i-` prefix keeps even a dot-like instance name inside a real
# directory instead of allowing it to name `..`; systemd also refuses names that
# are not valid normalized unit instance names, including any name with `/`.
ExecStart=/usr/bin/node /opt/durable-nanobot/dist/cli.js gateway --config %h/.durable-nanobot/instances/i-%i/config.json
WorkingDirectory=%h/.durable-nanobot/instances/i-%i
# Optional per-instance environment, e.g. one provider key per line. Keep the
# file private and outside this repository; it is ignored when absent.
EnvironmentFile=-%h/.durable-nanobot/instances/i-%i.env
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
